# ============================================================
#  Zoho Robotics — Tool Version Configuration
#  Update this file when upgrading tools.
#  All setup scripts read from here — do not hardcode
#  versions in the scripts themselves.
#
#  Last updated: 2026
#  Owner: Engineering Lead
# ============================================================

# ── ROS2 ─────────────────────────────────────────────────────
# Supported distros: humble, jazzy, kilted
# Check active distros: https://docs.ros.org/en/rolling/Releases.html
ROS2_DISTRO=humble

# ── Node.js ──────────────────────────────────────────────────
# Use LTS versions only (even numbers: 18, 20, 22, 24)
# Check LTS schedule: https://nodejs.org/en/about/releases
# Note: 18 is EOL April 2025, 20 is maintenance LTS, 22 is active LTS
NODE_MAJOR_VERSION=22

# ── Git ───────────────────────────────────────────────────────
# Minimum version required for git switch (introduced in 2.23)
GIT_MIN_VERSION=2.23

# ── pre-commit ───────────────────────────────────────────────
# Minimum major version
# Check releases: https://github.com/pre-commit/pre-commit/releases
PRECOMMIT_MIN_VERSION=3

# ── pipx ─────────────────────────────────────────────────────
# Minimum major version
PIPX_MIN_VERSION=1

# ── commitlint ───────────────────────────────────────────────
# npm package versions — used in package.json
COMMITLINT_CLI_VERSION=^19.0.0
COMMITLINT_CONFIG_VERSION=^19.0.0
HUSKY_VERSION=^9.0.0

# ── pre-commit hook revisions ─────────────────────────────────
# These match the rev: fields in .pre-commit-config.yaml
# Update with: pre-commit autoupdate
PRECOMMIT_HOOKS_REV=v4.6.0
CLANG_FORMAT_REV=v14.0.6
BLACK_REV=23.11.0
FLAKE8_REV=6.1.0

# ── clang-format ─────────────────────────────────────────────
# Must match CLANG_FORMAT_REV above (major version)
CLANG_FORMAT_VERSION=14

# ── Python ───────────────────────────────────────────────────
# Minimum Python version for pre-commit hooks
PYTHON_MIN_VERSION=3.8

# ── Code style ───────────────────────────────────────────────
# Maximum line length enforced by clang-format and flake8
MAX_LINE_LENGTH=100
